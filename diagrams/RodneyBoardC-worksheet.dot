      </TR>
      <TR>
        <TD BGCOLOR="#F7F3E8">manual access margin</TD>
        <TD BGCOLOR="#F7F3E8">switch pull-ups</TD>
        <TD BGCOLOR="#F7F3E8">bus crossing minimized</TD>
        <TD BGCOLOR="#F7F3E8">service room</TD>
        <TD BGCOLOR="#EAF1F8"><B>Bus Lane</B><BR/>J1 at X84,Y31<BR/>X87-X96</TD>
      </TR>
